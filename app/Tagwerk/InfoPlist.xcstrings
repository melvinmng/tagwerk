{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk liest deinen Kalender, um deinen Tag zu planen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk reads your calendar to plan your day."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk nimmt Fotos von Mahlzeiten auf, um Kalorien und Nährwerte schätzen zu lassen, und Fotos, die du an eine Notiz anhängst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk takes photos of meals to estimate calories and nutrients, and photos you attach to a note."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk zeigt deine Trainings, Schritte, Aktivitätsenergie, dein Gewicht und deine Körperdaten aus Health im Tab „Erfassen“ und liest auf Wunsch Ernährungseinträge anderer Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk shows your workouts, steps, active energy, weight and body data from Health in the “Log” tab and, on request, reads nutrition entries of other apps."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk speichert deine Mahlzeiten mit ihren Nährwerten, dein Wasser, deine Trainings und dein Gewicht in Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk saves your meals with their nutrients, your water, workouts and weight in Health."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk wandelt deine Sprache auf dem iPhone in Text um. Der Ton verlässt das Gerät nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk turns your speech into text on your iPhone. The audio never leaves the device."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk liest und bearbeitet deine Erinnerungen, um sie mit deinen anderen Aufgaben zusammenzuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwerk reads and edits your reminders to bring them together with your other tasks."
          }
        }
      }
    }
  },
  "version": "1.0"
}