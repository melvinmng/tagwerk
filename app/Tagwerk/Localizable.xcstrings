    "": {},
    "#%lld angelegt, aber %@ konnte nicht zugewiesen werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "#%1$lld angelegt, aber %2$@ konnte nicht zugewiesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld created, but %@ could not be assigned."
          }
        }
      }
    },
    "#%lld verschwindet aus Aufgaben und Planung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld will disappear from tasks and planning."
          }
        }
      }
    },
    "%@\n\nDie Anmeldung öffnet eine Seite von ChatGPT und kehrt danach von selbst zu Tagwerk zurück. Planen mit KI und der Assistent brauchen sie; alles andere läuft ohne.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSigning in opens a ChatGPT page and returns to Tagwerk on its own afterward. AI planning and the assistant need it; everything else works without it."
          }
        }
      }
    },
