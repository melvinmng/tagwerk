            "value": "The task no longer exists."
          }
        }
      }
    },
    "Die Aufgabe ist angelegt. Die Erinnerungen kannst du im Editor setzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task was created. You can set the reminders in the editor."
