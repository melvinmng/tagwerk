      }
    },
    "Hält Mitteilungen zu Aufgaben und Deadline-Terminen zurück, solange der Fokus aktiv ist. Sie kommen nach den Ruhezeiten oder nach dem Fokus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds back notifications for tasks and deadline events while the Focus is active. They arrive after quiet hours or after the Focus."
          }
        }
      }
    },
    "Häufigkeit": {
      "localizations": {
