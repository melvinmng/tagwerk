            "state": "translated",
            "value": "Send"
          }
        }
      }
    },
    "Senden gibt diesen Vorschlag, die übrigen der Planung, deine Änderungen, deine Vorgaben und die Termine dieser Tage an ChatGPT.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending gives ChatGPT this suggestion, the rest of the plan, your changes, your preferences and the events of these days."
          }
        }
      }
    },
    "Senden nach Pause": {
      "localizations": {
        "en": {
